# Copy this file to .env and fill it in. Never share .env.

# ---------- Reverb ----------
# reverb.com > Settings > API & Integrations > Personal Access Tokens (tick write_listings, read_profile)
REVERB_TOKEN=
# Set to true to test against sandbox.reverb.com (needs a separate sandbox account + token)
REVERB_SANDBOX=false
REVERB_CURRENCY=GBP
# Optional: use a saved shipping profile instead of per-item rates (python reverb_setup.py lists them)
REVERB_SHIPPING_PROFILE_ID=

# ---------- eBay ----------
# developer.ebay.com > My Account > Application Keys (Production keyset)
EBAY_ENV=production
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_DEV_ID=
# Sandbox keyset (used automatically when EBAY_ENV=sandbox)
EBAY_SANDBOX_CLIENT_ID=
EBAY_SANDBOX_CLIENT_SECRET=
EBAY_SANDBOX_RUNAME=
# "User Tokens" page > Get a Token from eBay via Your Application > RuName (looks like Joseph_Watmo-JosephWa-gearli-abcdef)
EBAY_RUNAME=
# Business policy IDs: python ebay_policies.py
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
EBAY_SHIPPING_POLICY_ID=
# Optional postage tiers picked per item with the ebay_postage column (collection|small|medium|large)
EBAY_SHIPPING_POLICY_SMALL_ID=
EBAY_SHIPPING_POLICY_MEDIUM_ID=
EBAY_SHIPPING_POLICY_LARGE_ID=
# Item location
EBAY_POSTCODE=
# Leave these unless you sell outside ebay.co.uk
EBAY_SITE_ID=3
EBAY_SITE_NAME=UK
EBAY_MARKETPLACE_ID=EBAY_GB
EBAY_CURRENCY=GBP
EBAY_COUNTRY=GB
